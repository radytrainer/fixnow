# Copy to .env (never commit .env)
PORT=4000
DATABASE_URL=postgres://fixnow@localhost:5440/fixnow
# Long random string. Required when NODE_ENV=production.
JWT_SECRET=change-me-to-a-long-random-string
# true = seeded demo sign-in + OTP code shown on screen (no SMS provider). Set false for production.
DEMO_MODE=true
# Comma-separated origins allowed by CORS, or *
CORS_ORIGINS=*
# STORAGE_DIR=./storage
